@model Student

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-danger shadow-sm text-center p-5">
            <div class="mb-4">
                <i class="bi bi-exclamation-octagon text-danger display-1"></i>
            </div>
            <h2 class="fw-bold">Remove Student?</h2>
            <p class="text-muted mb-4">You are about to delete <strong>@Model.Name</strong>. This record cannot be recovered.</p>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger btn-lg">Confirm Delete</button>
                    <a asp-action="Index" class="btn btn-link text-secondary">No, Keep Record</a>
                </div>
            </form>
        </div>
    </div>
</div>